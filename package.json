{
  "name": "roi-investment-workspace",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Investmentplanung, echte Marktdaten und nachvollziehbare Risikoanalysen.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-worker.mjs",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "check": "tsc -b",
    "refresh:data": "node --import tsx scripts/refresh-data.ts",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "format": "prettier --write src server tests scripts vite.config.ts index.html README.md --ignore-path .prettierignore",
    "build:pages": "tsc -b && vite build --mode github-pages && node scripts/build-pages.mjs",
    "preview:pages": "vite preview --mode github-pages --host 127.0.0.1 --port 4174",
    "refresh:pages": "node --import tsx scripts/refresh-pages-data.ts",
    "smoke:pages": "node scripts/smoke-pages.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "latest",
    "prettier": "^3.9.10",
    "tsx": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
